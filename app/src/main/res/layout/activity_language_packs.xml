<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout style="@style/PillHeader">
            <TextView
                style="@style/PillHeaderTitle"
                android:text="@string/packs_title" />
            <TextView
                style="@style/PillHeaderSubtitle"
                android:text="@string/packs_header_hint" />
        </LinearLayout>

        <TextView
            style="@style/SectionHeader"
            android:text="@string/packs_section_available" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="8dp"
            android:text="@string/packs_dict_note"
            android:textColor="?attr/textSecondaryColor"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/packs_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout style="@style/ItemPill"
            android:id="@+id/pill_enable_layout_hint"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="@string/packs_after_install_hint"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/btn_open_layout_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:text="@string/packs_open_layout_settings"
                android:textColor="#2E9E4F"
                android:textStyle="bold"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            style="@style/SectionHeader"
            android:text="@string/packs_section_updates" />

        <LinearLayout style="@style/ItemPill"
            android:id="@+id/btn_packs_more_languages"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="@string/packs_more_languages_hint"
                android:textColor="?attr/textSecondaryColor"
                android:textSize="12sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:text="@string/packs_more_languages"
                android:textColor="#2E9E4F"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout style="@style/ItemPill"
            android:id="@+id/btn_packs_release_page">
            <TextView
                style="@style/ItemPillText"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/packs_open_release_page" />
            <TextView style="@style/Chevron" android:text="›" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
