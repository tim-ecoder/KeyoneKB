<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ai10.k12kb.lang.de"
    android:versionCode="3"
    android:versionName="1.1.1" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="27" />
    <!--
      Пакет данных: ни кода, ни разрешений. Клавиатура находит его по действию
      LANGUAGE_PACK, проверяет подпись и читает assets через createPackageContext.
    -->
    <application
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round" >
        <service
            android:name="com.ai10.k12kb.langpack.LanguagePackService"
            android:enabled="true"
            android:exported="true" >
            <intent-filter>
                <action android:name="com.ai10.k12kb.LANGUAGE_PACK" />
            </intent-filter>

            <meta-data
                android:name="com.ai10.k12kb.languages"
                android:value="de" />
        </service>
    </application>

</manifest>