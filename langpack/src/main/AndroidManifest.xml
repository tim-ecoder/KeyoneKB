<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ai10.k12kb.langpack">

    <!--
      Пакет данных: ни кода, ни разрешений. Клавиатура находит его по действию
      LANGUAGE_PACK, проверяет подпись и читает assets через createPackageContext.
    -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasCode="true">

        <service
            android:name="com.ai10.k12kb.langpack.LanguagePackService"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.ai10.k12kb.LANGUAGE_PACK" />
            </intent-filter>
            <meta-data
                android:name="com.ai10.k12kb.languages"
                android:value="${packLanguages}" />
        </service>
    </application>
</manifest>
